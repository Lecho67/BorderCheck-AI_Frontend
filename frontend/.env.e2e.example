# Credenciales de las cuentas dedicadas para el E2E autenticado.
# Copiar a `.env.e2e` (git-ignored) y completar. Sin `.env.e2e`, `npm run
# test:e2e` corre solo la suite de páginas públicas.
#
# Crear los 3 usuarios en Supabase (Authentication -> Users, con "Auto
# Confirm") y setear su rol/estado con el SQL de docs/PLAN_DE_PRUEBAS.md § 7.1.
#
# NO poner contraseñas reales acá — este archivo se versiona. La cuenta
# e2e.admin tiene rol admin (control total del proyecto).

E2E_CLIENTE_EMAIL=e2e.cliente@bordercheck.test
E2E_CLIENTE_PASSWORD=

E2E_AGENTE_EMAIL=e2e.agente@bordercheck.test
E2E_AGENTE_PASSWORD=

E2E_ADMIN_EMAIL=e2e.admin@bordercheck.test
E2E_ADMIN_PASSWORD=

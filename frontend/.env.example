# Copiar a .env y completar con los valores reales (no commitear .env).

# Obligatorias — sin ellas src/lib/supabase.ts lanza un error y la app no carga
VITE_SUPABASE_URL=https://<tu-proyecto>.supabase.co
VITE_SUPABASE_ANON_KEY=<tu-anon-o-publishable-key>

# Opcional — si se omite, el frontend usa el mock local (src/lib/mockData.ts)
VITE_API_BASE_URL=http://localhost:3000

# Opcional — API key para autenticar POST /api/v1/shipments/evaluate ante el
# motor de reglas (header X-API-Key). Debe coincidir con una de las keys que
# el backend tiene en su propio API_KEYS. Sin ella, el request se manda sin
# el header y el backend lo rechaza si AUTH_ENABLED=true de su lado.
VITE_X_API_KEY=

# Opcional — ID de medición de Google Analytics 4 (formato G-XXXXXXXXXX).
# Sin ella, CookieConsentBanner no carga ningún script de analítica (el
# aviso de cookies igual se muestra para poder activarla más adelante sin
# tocar código, solo agregando esta variable).
VITE_GA_MEASUREMENT_ID=
